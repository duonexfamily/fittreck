# Скопируй в backend/.env и заполни. Файл .env в git не попадает.
# В продакшене эти же переменные задаются в Railway → Variables.

# dev — polling, prod — webhook
ENV=dev

# Токен бота из BotFather (для dev и prod — разные боты)
BOT_TOKEN=

# Случайная строка для заголовка X-Telegram-Bot-Api-Secret-Token (только prod)
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Supabase → Connect → Session pooler (порт 5432). Схему заменить на postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# HTTPS-адрес Mini App: домен Railway (prod) или адрес туннеля (dev)
WEBAPP_URL=

# Telegram ID администраторов через запятую
ADMIN_IDS=

LOG_LEVEL=INFO
